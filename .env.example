NODE_ENV=development
PORT=3000
APP_ENV=local
SINGLE_USER_ID=single-user
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIRESTORE_DATABASE_ID=default
FCM_ANDROID_DEVICE_TOKEN=
CRON_SECRET=change-me

GEMINI_API_KEY=your-gemini-api-key
# Model used by the AI stock picker. Defaults to the latest stable Flash model.
GEMINI_MODEL=gemini-2.5-flash

# Emergency AI fallback (used only if every Gemini attempt fails).
# Qwen via OpenRouter's OpenAI-compatible API.
OPENROUTER_API_KEY=
QWEN_MODEL=qwen/qwen-2.5-3b-instruct

# Buy-scan quality thresholds. The scan may return fewer than five when the
# market does not offer enough strong opportunities; it never fills slots with
# deliberately weaker trades.
BUY_SCAN_MIN_CHANGE_PERCENT=1.5
BUY_SCAN_MIN_VOLUME=100000
BUY_SCAN_MIN_INTRADAY_RANGE_PERCENT=1
BUY_SCAN_MAX_DISTANCE_FROM_HIGH_PERCENT=1.5
# Price band for buy-scan candidates (this account trades ₹40–₹150 stocks)
BUY_SCAN_MIN_PRICE=40
BUY_SCAN_MAX_PRICE=150
# Maximum number of best picks the daily scan notifies (top-N, not a guarantee)
BUY_SCAN_TOP_PICKS=5
# Maximum signals from one sector in a single scan (reduces correlated risk)
BUY_SCAN_MAX_PER_SECTOR=2
# Trade plan shown in buy notifications: SL/target as % from entry, and the
# max rupees per trade used to size quantity when no monthly setup exists
# (otherwise the setup's maxTradeCapital is used)
BUY_SCAN_STOP_LOSS_PERCENT=3
BUY_SCAN_TARGET_PERCENT=7
BUY_SCAN_DEFAULT_CAPITAL=10000

# Sell-scan thresholds for open positions (Trade tab): a position down more
# than SELL_SCAN_DOWN_PERCENT gets a sell signal; up more than
# SELL_SCAN_UP_PERCENT gets a hold signal. Between the two, no alert.
SELL_SCAN_DOWN_PERCENT=3
SELL_SCAN_UP_PERCENT=5

# Market data source for the buy/sell scans:
#   yahoo    → works from anywhere (Vercel included). Default.
#   angelone → real-time, but Angel One's WAF blocks cloud IPs, so it only
#              works when the server runs from a residential IP.
SCAN_DATA_SOURCE=yahoo

# Angel One Smart API (for real-time NSE/BSE market data)
ANGEL_ONE_TOTP_SECRET=your-totp-secret
ANGEL_ONE_MPIN=your-mpin
ANGEL_ONE_CLIENT_ID=your-client-id
ANGEL_ONE_API_KEY=your-api-key
